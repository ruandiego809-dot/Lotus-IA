# Copy to android/key.properties (DO NOT COMMIT key.properties or keystore files)
# Generate a release keystore:
# keytool -genkey -v -keystore ~/lotus-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias lotus
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=lotus
storeFile=/absolute/path/to/lotus-release.jks
